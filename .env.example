# ==========================================
# NEXTCLOUD BACKUP
# ==========================================

# PostgreSQL
DB_NAME=nextcloud
DB_USER=nextcloud
DB_PASSWORD=DEIN_POSTGRES_PASSWORT

# Borg
BORG_REPO=user@zielserver:/pfad/zum/backup-repo
BORG_PASSPHRASE=DEINE_SEHR_LANGE_BORG_PASSPHRASE

# Optional: SSH-Key für Borg
# BORG_RSH=ssh -i /root/.ssh/borg_backup

# Optional: Restore-Healthcheck
# HEALTHCHECK_URL=http://127.0.0.1/status.php
# HEALTHCHECK_TIMEOUT=120
# POLL_INTERVAL=2
